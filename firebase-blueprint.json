{
  "entities": {
    "Wallet": {
      "title": "Wallet",
      "description": "A user's personal CDCCoin Demo Coin vault storing integer cent balance, security settings, daily transfer limits, and PIN hash.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the wallet owner."
        },
        "walletAddress": {
          "type": "string",
          "minLength": 13,
          "maxLength": 13,
          "pattern": "^CDC-[A-Z0-9]{4}-[A-Z0-9]{4}$",
          "description": "Unique shareable P2P wallet address."
        },
        "walletName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "description": "Human-friendly label for the wallet."
        },
        "balanceCents": {
          "type": "integer",
          "description": "Current Demo Coin balance in integer cents (100 cents = 1.00 CDC)."
        },
        "dailySendLimitCents": {
          "type": "integer",
          "description": "Maximum CDC cents allowed to be sent per calendar day."
        },
        "dailySentTodayCents": {
          "type": "integer",
          "description": "Total CDC cents sent on lastSentDate."
        },
        "lastSentDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$",
          "description": "YYYY-MM-DD date string of the last outgoing transfer."
        },
        "isFrozen": {
          "type": "boolean",
          "description": "When true, outgoing and incoming transfers are blocked."
        },
        "requirePinForSend": {
          "type": "boolean",
          "description": "Whether the 4-6 digit Security PIN is required before sending."
        },
        "pinHash": {
          "type": "string",
          "maxLength": 128,
          "description": "Salted SHA-256 hex digest of the Security PIN, or empty string if unset."
        },
        "lastTxId": {
          "type": "string",
          "maxLength": 128,
          "description": "Most recent transaction ID applied to this wallet."
        },
        "alertsEnabled": {
          "type": "boolean",
          "description": "Whether daily spending limit threshold alerts are enabled."
        },
        "alertThresholdPct": {
          "type": "integer",
          "description": "Percentage (50-100) of dailySendLimitCents at which an approaching alert triggers."
        },
        "biometricEnabled": {
          "type": "boolean",
          "description": "Whether a WebAuthn passkey/biometric credential is enrolled."
        },
        "biometricCredentialId": {
          "type": "string",
          "maxLength": 256,
          "description": "Base64url-encoded WebAuthn credential ID."
        },
        "biometricDeviceLabel": {
          "type": "string",
          "maxLength": 40,
          "description": "Human-friendly device label for the enrolled authenticator."
        },
        "requireBiometricForAccess": {
          "type": "boolean",
          "description": "Whether wallet access requires verification on new sessions or manual lock."
        },
        "biometricMode": {
          "type": "string",
          "enum": ["either", "both"],
          "description": "Whether biometric acts as an alternative (either) or additional (both) factor alongside PIN."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of wallet creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last wallet update."
        }
      },
      "required": [
        "ownerUid",
        "walletAddress",
        "walletName",
        "balanceCents",
        "dailySendLimitCents",
        "dailySentTodayCents",
        "lastSentDate",
        "isFrozen",
        "requirePinForSend",
        "pinHash",
        "lastTxId",
        "createdAt",
        "updatedAt"
      ]
    },
    "WalletDirectoryEntry": {
      "title": "WalletDirectoryEntry",
      "description": "Public P2P address lookup entry without PII (no email or phone).",
      "type": "object",
      "properties": {
        "walletAddress": {
          "type": "string",
          "minLength": 13,
          "maxLength": 13,
          "pattern": "^CDC-[A-Z0-9]{4}-[A-Z0-9]{4}$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "walletName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "isFrozen": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "walletAddress",
        "ownerUid",
        "displayName",
        "walletName",
        "isFrozen",
        "createdAt",
        "updatedAt"
      ]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Immutable P2P transfer or demo faucet ledger entry.",
      "type": "object",
      "properties": {
        "txId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["p2p_transfer", "faucet_grant"]
        },
        "fromUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromAddress": {
          "type": "string",
          "minLength": 13,
          "maxLength": 13,
          "pattern": "^CDC-[A-Z0-9]{4}-[A-Z0-9]{4}$"
        },
        "fromName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "toUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "toAddress": {
          "type": "string",
          "minLength": 13,
          "maxLength": 13,
          "pattern": "^CDC-[A-Z0-9]{4}-[A-Z0-9]{4}$"
        },
        "toName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "participants": {
          "type": "array",
          "description": "Exactly 2 UIDs: [fromUid, toUid]."
        },
        "amountCents": {
          "type": "integer"
        },
        "note": {
          "type": "string",
          "maxLength": 140
        },
        "status": {
          "type": "string",
          "enum": ["completed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "txId",
        "type",
        "fromUid",
        "fromAddress",
        "fromName",
        "toUid",
        "toAddress",
        "toName",
        "participants",
        "amountCents",
        "note",
        "status",
        "createdAt"
      ]
    },
    "Contact": {
      "title": "Contact",
      "description": "Saved P2P recipient address book entry.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "walletAddress": {
          "type": "string",
          "minLength": 13,
          "maxLength": 13,
          "pattern": "^CDC-[A-Z0-9]{4}-[A-Z0-9]{4}$"
        },
        "nickname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "walletAddress",
        "nickname",
        "createdAt"
      ]
    },
    "SecurityLog": {
      "title": "SecurityLog",
      "description": "Immutable per-wallet security audit trail event.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "eventType": {
          "type": "string",
          "enum": [
            "wallet_created",
            "pin_updated",
            "wallet_frozen",
            "wallet_unfrozen",
            "limit_updated",
            "alert_settings_updated",
            "limit_alert_approaching",
            "limit_alert_exceeded",
            "biometric_enrolled",
            "biometric_removed",
            "biometric_verified",
            "wallet_locked",
            "wallet_unlocked",
            "p2p_sent",
            "faucet_claimed"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "eventType",
        "summary",
        "createdAt"
      ]
    },
    "PaymentRequest": {
      "title": "PaymentRequest",
      "description": "Shareable P2P Demo Coin payment request.",
      "type": "object",
      "properties": {
        "reqId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "requesterUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "requesterAddress": {
          "type": "string",
          "minLength": 13,
          "maxLength": 13,
          "pattern": "^CDC-[A-Z0-9]{4}-[A-Z0-9]{4}$"
        },
        "requesterName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "amountCents": {
          "type": "integer"
        },
        "memo": {
          "type": "string",
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "enum": ["open", "paid", "cancelled"]
        },
        "paidByUid": {
          "type": "string",
          "maxLength": 128
        },
        "paidTxId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "reqId",
        "requesterUid",
        "requesterAddress",
        "requesterName",
        "amountCents",
        "memo",
        "status",
        "paidByUid",
        "paidTxId",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/wallets/{uid}": {
      "schema": { "$ref": "#/entities/Wallet" },
      "description": "Owner-only wallet vault document storing balanceCents and security controls."
    },
    "/wallets/{uid}/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/Contact" },
      "description": "Saved P2P recipient contacts owned by the wallet user."
    },
    "/wallets/{uid}/security_logs/{logId}": {
      "schema": { "$ref": "#/entities/SecurityLog" },
      "description": "Immutable security event audit trail for the wallet owner."
    },
    "/wallet_directory/{walletAddress}": {
      "schema": { "$ref": "#/entities/WalletDirectoryEntry" },
      "description": "Public P2P address lookup directory without PII."
    },
    "/transactions/{txId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Immutable P2P transfer and faucet ledger."
    },
    "/payment_requests/{reqId}": {
      "schema": { "$ref": "#/entities/PaymentRequest" },
      "description": "Shareable P2P payment requests."
    }
  }
}
